# ---------------------------------------------------------------------------
# Brightpath Crisis Relief Foundation — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Core ---
# A long random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Port the app listens on (gunicorn / flask). Defaults to 8080.
PORT=8080

# --- Persistent data (Docker / Cloudflare Tunnel) ---
# Where the SQLite database and user uploads live. Point this at a mounted
# volume so data survives redeploys. Defaults to the app directory.
BRIGHTPATH_DATA_DIR=/data
# Optional explicit overrides (rarely needed):
# BRIGHTPATH_DB=/data/charity.db
# BRIGHTPATH_UPLOAD_DIR=/data/uploads

# --- Bootstrap administrator (used only when the database is first created) ---
ADMIN_EMAIL=admin@brightfuturegrant.com
ADMIN_PASSWORD=use-a-strong-unique-password

# --- Email (optional) ---
# Leave blank to log emails to the database instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@brightfuturegrant.com

# --- Cloudflare Tunnel (used by docker-compose) ---
# The tunnel token from: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
